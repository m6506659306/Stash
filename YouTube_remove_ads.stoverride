name: YouTube
desc: |-
  去广告；导航栏改写；后台播放。
icon: https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png
category: 去广告

http:
  mitm:
    - "*.googlevideo.com"
    - youtubei.googleapis.com
  script:
    - name: youtube.response
      match: '^https://youtubei\.googleapis\.com/(youtubei/v1/(browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config))(\?(.*))?$'
      type: response
      require-body: true
      binary-mode: true
      max-size: 10485760
      argument: '{"captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":true,"debug":false}'
    - name: youtube.request
      match: '^https?://[\w-]+\.googlevideo\.com/initplayback.+&ack.*'
      type: request
      require-body: true
      binary-mode: true
      max-size: 10485760
    - name: youtube.request
      match: '^https://youtubei\.googleapis\.com/youtubei/v1/log_event'
      type: request
      require-body: true
      binary-mode: true
      max-size: 10485760

script-providers:
  youtube.response:
    url: https://raw.githubusercontent.com/m6506659306/stash/main/Script/Youtube/youtube.response.js
    interval: 86400
  youtube.request:
    url: https://raw.githubusercontent.com/m6506659306/stash/main/Script/Youtube/youtube.request.js
    interval: 86400
